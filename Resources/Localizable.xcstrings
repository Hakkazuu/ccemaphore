    "settings.updates.unavailable.debug": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In Debug-Builds sind Updates aus, damit sich eine Entwicklungskopie nie durch das Release ersetzt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Updates are off in debug builds, so a development copy never replaces itself with the release."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las actualizaciones están desactivadas en las compilaciones de depuración, para que una copia de desarrollo nunca se sustituya por la versión publicada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les mises à jour sont désactivées dans les builds de débogage, pour qu'une copie de développement ne soit jamais remplacée par la version publiée."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В отладочных сборках обновления выключены, чтобы копия для разработки не заменилась релизом."
          }
        }
      }
    },
