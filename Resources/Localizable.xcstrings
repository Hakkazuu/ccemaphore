    "settings.codex.permission.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Red light and a ribbon when Codex asks for approval; trusted commands are auto-allowed. Codex shows its own prompt right away."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Красный свет и лента, когда Codex просит подтверждение; доверенные команды разрешаются автоматически. Codex сразу показывает свой запрос."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
