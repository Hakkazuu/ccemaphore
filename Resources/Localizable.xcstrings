    "update.consent.body": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "ccemaphore prüft einmal täglich bei GitHub. GitHub sieht nur deine IP-Adresse, die App-Version und deine Sprache – nie deine Chats."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "ccemaphore checks GitHub once a day. GitHub sees only your IP address, the app version and your language — never your chats."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "ccemaphore consulta GitHub una vez al día. GitHub solo ve tu dirección IP, la versión de la app y tu idioma, nunca tus chats."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "ccemaphore vérifie GitHub une fois par jour. GitHub ne voit que votre adresse IP, la version de l'app et votre langue — jamais vos discussions."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Раз в день ccemaphore проверяет GitHub. GitHub видит только ваш IP-адрес, версию приложения и язык — но не ваши чаты."
          }
        }
      }
    },
