          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Rotes Licht und Leiste, wenn Codex um Freigabe bittet; vertrauenswürdige Befehle werden automatisch erlaubt. Codex zeigt seine eigene Abfrage sofort."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Feu rouge et bandeau quand Codex demande une approbation ; les commandes de confiance sont autorisées automatiquement. Codex affiche sa propre demande immédiatement."
          }
        }
      }
    },
