    "settings.updates.privacy": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Prüfung fragt GitHub nach dem neuesten Release: GitHub sieht deine IP-Adresse, die App-Version und deine Sprache. Chatdaten oder Kennungen verlassen nie deinen Mac."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A check asks GitHub for the latest release: GitHub sees your IP address, the app version and your language. No chat data or identifiers ever leave your Mac."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada comprobación pide a GitHub la última versión: GitHub ve tu dirección IP, la versión de la app y tu idioma. Ningún dato de chats ni identificador sale nunca de tu Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une vérification demande la dernière version à GitHub : GitHub voit votre adresse IP, la version de l'app et votre langue. Aucune donnée de discussion ni aucun identifiant ne quitte jamais votre Mac."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проверка запрашивает у GitHub последний релиз: GitHub видит ваш IP-адрес, версию приложения и язык. Данные чатов и идентификаторы никогда не покидают ваш Mac."
          }
        }
      }
    },
