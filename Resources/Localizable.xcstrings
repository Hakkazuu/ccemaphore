          "stringUnit": {
            "state": "translated",
            "value": "Aún sin revisar: abre la app de ChatGPT → ajustes de Codex → Hooks y aprueba hooks.json (o ejecuta /hooks en la CLI de Codex). Hasta entonces los hooks no se ejecutan."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch nicht geprüft: öffne die ChatGPT-App → Codex-Einstellungen → Hooks und genehmige hooks.json (oder führe /hooks in der Codex-CLI aus). Bis dahin laufen die Hooks nicht."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas encore validés : ouvrez l’app ChatGPT → réglages Codex → Hooks et approuvez hooks.json (ou lancez /hooks dans la CLI Codex). Jusque-là, les hooks ne s’exécutent pas."
          }
        }
      }
    },
    "settings.desktopWait.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold the permission hook for the desktop app like for an IDE. Experimental: check that the app’s own card still works."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удерживать хук разрешений для десктопного приложения, как для IDE. Экспериментально: проверьте, что родная карточка приложения работает."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Retener el hook de permisos para la app de escritorio como en un IDE. Experimental: comprueba que la tarjeta propia de la app sigue funcionando."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Den Berechtigungs-Hook für die Desktop-App wie bei einer IDE halten. Experimentell: prüfe, dass die app-eigene Karte weiter funktioniert."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Retenir le hook d’autorisation pour l’app de bureau comme pour un IDE. Expérimental : vérifiez que la carte native de l’app fonctionne toujours."
          }
        }
      }
    },
