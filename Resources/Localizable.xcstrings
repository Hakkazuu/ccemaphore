    "settings.hooks.blockedTransient": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bewege ccemaphore zuerst nach „Programme“ – sonst würden die Hooks auf einen temporären Ort zeigen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Move ccemaphore to Applications first — hooks would point into a temporary location."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Primero mueve ccemaphore a Aplicaciones: los hooks apuntarían a una ubicación temporal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déplacez d'abord ccemaphore dans Applications — sinon les hooks pointeraient vers un emplacement temporaire."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сначала переместите ccemaphore в «Программы» — иначе хуки будут указывать на временное расположение."
          }
        }
      }
    },
    "settings.hooks.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Installiert Claude-Code-Hooks, die das Ende eines Zugs und das Warten auf Eingaben präzise erkennen – zuverlässiger als über die Dateien."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Installs Claude Code hooks that detect turn completion and waiting-for-input precisely — more reliably than reading the files."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Instala los hooks de Claude Code que detectan el fin del turno y la espera de entrada con precisión, más fiable que por los archivos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Installe les hooks de Claude Code qui détectent précisément la fin du tour et l'attente d'une saisie — plus fiable que par les fichiers."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Устанавливает хуки Claude Code: точно определяют завершение хода и ожидание ввода — надёжнее, чем по файлам."
          }
        }
      }
    },
    "settings.hooks.title": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Präzise Statuserkennung"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Precise status detection"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Detección precisa del estado"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Détection précise du statut"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Точное определение статуса"
          }
        }
      }
    },
    "settings.idelog.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Liest das Log der Cursor/VS-Code-Erweiterung, um das Berechtigungsband sofort auszublenden, wenn du in der IDE antwortest (nicht erst nach Befehlsende). Undokumentiertes IDE-Log – kann bei IDE-Updates brechen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reads the Cursor/VS Code extension log to drop the permission ribbon the moment you answer in the IDE (not when the command finishes). Undocumented IDE log — may break on IDE updates."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lee el registro de la extensión de Cursor/VS Code para quitar la solicitud en cuanto respondes en el IDE (no al terminar el comando). Registro interno del IDE: puede romperse al actualizar el IDE."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lit le journal de l’extension Cursor/VS Code pour masquer la demande dès que vous répondez dans l’IDE (et non à la fin de la commande). Journal interne de l’IDE — peut casser lors des mises à jour de l’IDE."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Читает лог расширения Cursor/VS Code, чтобы убрать ленту разрешения сразу после вашего ответа в IDE (а не по завершении команды). Внутренний лог IDE — может сломаться на обновлении IDE."
          }
        }
      }
    },
    "settings.idelog.subtitle.needHook": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
