    "settings.updates.mode.subtitle.automatic": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prüft täglich und lädt im Hintergrund; ein Klick startet neu in die neue Version."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Checks daily and downloads in the background; one click restarts into the new version."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Busca a diario y descarga en segundo plano; un clic reinicia con la nueva versión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifie chaque jour et télécharge en arrière-plan ; un clic redémarre sur la nouvelle version."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проверяет раз в день и скачивает в фоне; перейти на новую версию можно одним кликом."
          }
        }
      }
    },
    "settings.updates.mode.subtitle.notifyOnly": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prüft täglich und meldet neue Versionen; geladen wird erst, wenn du auf „Aktualisieren“ klickst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Checks daily and tells you when a version is out; nothing downloads until you click Update."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Busca a diario y te avisa de cada versión nueva; no se descarga nada hasta que pulses «Actualizar»."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifie chaque jour et vous signale les nouvelles versions ; rien n'est téléchargé avant que vous cliquiez sur « Mettre à jour »."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проверяет раз в день и сообщает о новой версии; ничего не скачивается, пока вы не нажмёте «Обновить»."
          }
        }
      }
    },
    "settings.updates.mode.subtitle.off": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prüft nie von selbst – nutze „Jetzt prüfen“, wann immer du willst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Never checks on its own — use Check now whenever you like."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nunca busca por su cuenta: usa «Buscar ahora» cuando quieras."
