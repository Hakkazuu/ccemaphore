    "settings.groups.explainer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A product is one folder holding several repos (backend, frontend, landing). Chats under it are grouped together. Codex projects and folders with 2+ active repos are suggested automatically; add your own roots below."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Продукт — это папка с несколькими репозиториями (backend, frontend, лендинг). Чаты внутри неё группируются вместе. Проекты Codex и папки с 2+ активными репозиториями подставляются автоматически; свои корни добавьте ниже."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un producto es una carpeta con varios repos (backend, frontend, landing). Los chats dentro se agrupan. Los proyectos de Codex y las carpetas con 2+ repos activos se sugieren automáticamente; añade tus propias raíces abajo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Produkt ist ein Ordner mit mehreren Repos (Backend, Frontend, Landing). Chats darunter werden gruppiert. Codex-Projekte und Ordner mit 2+ aktiven Repos werden automatisch vorgeschlagen; eigene Wurzeln unten hinzufügen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un produit est un dossier contenant plusieurs dépôts (backend, frontend, landing). Les discussions qu’il contient sont regroupées. Les projets Codex et les dossiers avec 2 dépôts actifs ou plus sont proposés automatiquement ; ajoutez vos propres racines ci-dessous."
          }
        }
      }
    },
