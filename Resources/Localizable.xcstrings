    },
    "update.move.body": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es läuft aus dem Disk-Image oder „Downloads“ – dort kann es sich nicht aktualisieren und seine Hooks würden ausfallen. Beende es, zieh es nach „Programme“ und öffne es von dort."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It's running from the disk image or Downloads, where it can't update itself and its hooks would break. Quit it, drag it into Applications, then open it from there."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se está ejecutando desde la imagen de disco o Descargas, donde no puede actualizarse y sus hooks fallarían. Ciérralo, arrástralo a Aplicaciones y ábrelo desde ahí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il s'exécute depuis l'image disque ou Téléchargements, où il ne peut pas se mettre à jour et où ses hooks ne fonctionneraient plus. Quittez-le, glissez-le dans Applications, puis ouvrez-le depuis là."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "ccemaphore запущен из образа диска или «Загрузок»: оттуда он не может обновляться, а его хуки перестанут работать. Завершите его, перетащите в «Программы» и откройте оттуда."
          }
        }
      }
    },
    "update.move.title": {
