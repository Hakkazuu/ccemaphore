    "update.available.downloaded.body": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klicke auf „Installieren“, um das Update abzuschließen – ccemaphore startet neu, und macOS fragt eventuell nach einem Administratorpasswort."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Click Install to finish updating — ccemaphore restarts, and macOS may ask for an administrator password."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulsa «Instalar» para terminar la actualización: ccemaphore se reiniciará y macOS puede pedir una contraseña de administrador."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cliquez sur « Installer » pour terminer la mise à jour : ccemaphore redémarre et macOS peut demander un mot de passe administrateur."
